# Required — for Explorer to clone repos
GITHUB_TOKEN=ghp_...

# Optional — enables LangSmith tracing
LANGCHAIN_API_KEY=lsv2_...
LANGCHAIN_PROJECT=eureka
LANGCHAIN_TRACING_V2=true

# Note: ANTHROPIC_API_KEY is NOT needed. Agents use claude-agent-sdk
# which authenticates via OAuth (Claude Max plan). Run `claude login` once.
